{
  "name": "financial_encoder",
  "version": "1.0.3",
  "description": "Financial Encoder — a local/offline financial encoding and analysis desktop application for Windows.",
  "main": "dist-electron/main.js",
  "author": "GilmierDev",
  "homepage": "https://github.com/gilmierdev/financial_encoder",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n RENDERER,ELECTRON -c cyan,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "watch:electron": "tsc -p tsconfig.electron.json --watch",
    "dev:electron": "concurrently -k \"npm:watch:electron\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "dist": "npm run build && electron-builder --config electron-builder.config.js",
    "dist:dir": "npm run build && electron-builder --dir --config electron-builder.config.js",
    "release": "npm run build && electron-builder --config electron-builder.config.js --publish never",
    "release:publish": "npm run build && electron-builder --config electron-builder.config.js --publish always",
    "electron:build": "npm run dist",
    "electron:dev": "npm run dev"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tesseract.js": "^0.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "sass": "^1.104.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
